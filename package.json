{
  "name": "remark-mermaid-tldraw",
  "version": "0.1.0",
  "description": "Render mermaid diagrams as tldraw's hand-drawn SVGs at build time — a remark plugin + headless renderer with light/dark variants and content-hash caching.",
  "type": "module",
  "license": "MIT",
  "author": "Sean Geng",
  "homepage": "https://github.com/seangeng/remark-mermaid-tldraw",
  "repository": {
    "type": "git",
    "url": "github:seangeng/remark-mermaid-tldraw"
  },
  "keywords": [
    "remark",
    "remark-plugin",
    "mermaid",
    "tldraw",
    "mdx",
    "markdown",
    "astro",
    "diagram",
    "svg",
    "dark-mode"
  ],
  "bin": {
    "remark-mermaid-tldraw": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "harness",
    "GUIDE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "tinyglobby": "^0.2.10",
    "unist-util-visit": "^5.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependencies": {
    "@tldraw/mermaid": "^5.0.0",
    "playwright": "^1.40.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tldraw": "^5.0.0"
  },
  "devDependencies": {
    "@tldraw/mermaid": "^5.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "^5.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
